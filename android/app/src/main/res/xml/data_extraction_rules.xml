<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup and device-to-device transfer carry the player's settings, saved scales and lessons
  (shared preferences and files), so a new phone opens where the old one left off.
  Nothing is excluded: the app keeps no account, token or device-specific data.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
