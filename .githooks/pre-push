#!/bin/sh
# Runs `make verify` before every push, so nothing reaches the remote with a feature
# missing on one platform, stale expected/answers.json, lint errors or failing tests.
# The owner enables it once per clone with:  git config core.hooksPath .githooks
# Skip it for one push with:  git push --no-verify
set -e
cd "$(git rev-parse --show-toplevel)"
exec make verify
